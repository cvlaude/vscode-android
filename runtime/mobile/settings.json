{
  "workbench.colorTheme": "Dark Modern",
  "workbench.experimental.modernUI": false,
  "workbench.colorCustomizations": {
    "statusBar.background": "#0078d4",
    "statusBar.foreground": "#ffffff",
    "statusBar.noFolderBackground": "#0078d4"
  },
  "workbench.activityBar.location": "top",
  "workbench.sideBar.location": "left",
  "workbench.secondarySideBar.defaultVisibility": "hidden",
  "workbench.startupEditor": "none",
  "workbench.editor.animations": true,
  "workbench.editor.tabActionCloseVisibility": true,
  "workbench.editor.tabActionLocation": "right",
  "workbench.editor.allowDropIntoGroup": true,
  "chat.disableAIFeatures": true,
  "workbench.editor.tabSizing": "shrink",
  "workbench.layoutControl.enabled": false,
  "workbench.sash.size": 20,
  "window.menuBarVisibility": "classic",
  "security.workspace.trust.enabled": false,
  "security.workspace.trust.startupPrompt": "never",
  "editor.fontSize": 15,
  "editor.lineHeight": 23,
  "editor.minimap.enabled": false,
  "editor.stickyScroll.enabled": false,
  "editor.wordWrap": "on",
  "editor.folding": false,
  "breadcrumbs.enabled": false,
  "files.autoSave": "afterDelay",
  "files.autoSaveDelay": 500,
  "files.hotExit": "onExitAndWindowClose",
  "git.autorefresh": false,
  "telemetry.telemetryLevel": "off",
  "update.mode": "none",
  "extensions.autoUpdate": false,
  "livePreview.portNumber": 6969,
  "livePreview.autoRefreshPreview": "Never",
  "chatgpt.composerEnterBehavior": "cmdAlways",
